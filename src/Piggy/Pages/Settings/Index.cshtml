@page
@model Piggy.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
}

<h2 class="mb-4">Settings</h2>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}

<div class="row mb-4">
    <div class="col-md-6">
        <a asp-page="/Accounts/Index" class="text-decoration-none">
            <div class="card">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-wallet2 fs-3 me-3"></i>
                    <div>
                        <h5 class="mb-0">Accounts</h5>
                        <small class="text-muted">Manage virtual accounts</small>
                    </div>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a asp-page="/Splits/Index" class="text-decoration-none">
            <div class="card">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-layers fs-3 me-3"></i>
                    <div>
                        <h5 class="mb-0">Splits</h5>
                        <small class="text-muted">Manage split templates</small>
                    </div>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a asp-page="/Data/Index" class="text-decoration-none">
            <div class="card">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-database fs-3 me-3"></i>
                    <div>
                        <h5 class="mb-0">Data</h5>
                        <small class="text-muted">Import and export database</small>
                    </div>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a asp-page="/TwoFactor/Setup" class="text-decoration-none">
            <div class="card">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-shield-lock fs-3 me-3"></i>
                    <div>
                        <h5 class="mb-0">Two-Factor Auth</h5>
                        <small class="text-muted">Manage authenticator app</small>
                    </div>
                    <i class="bi bi-chevron-right ms-auto"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Split Overflow Account</h5>
        <p class="text-muted">When a split template's total exceeds the transaction amount, the overflow difference is assigned to this account.</p>

        <form method="post">
            <div class="mb-3">
                <label for="OverflowAccountId" class="form-label">Overflow Account</label>
                <select asp-for="OverflowAccountId" class="form-select">
                    <option value="">-- None (no overflow handling) --</option>
                    @foreach (var account in Model.Accounts)
                    {
                        <option value="@account.Id" selected="@(account.Id == Model.OverflowAccountId)">
                            @account.Name (@account.StartingBalance.ToString("N2") EUR)
                        </option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Save Settings</button>
        </form>
    </div>
</div>
