@page
@model Piggy.Pages.Accounts.CreateModel
@{
    ViewData["Title"] = "Create Virtual Account";
}

<h2>Create Virtual Account</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Account.Name" class="form-label">Name</label>
                <input asp-for="Account.Name" class="form-control" placeholder="e.g., ISP, House, Car" />
                <span asp-validation-for="Account.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Account.Color" class="form-label">Color</label>
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="Account.Color" type="color" class="form-control form-control-color" />
                    <span asp-validation-for="Account.Color" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Account.StartingBalance" class="form-label">Starting Balance (EUR)</label>
                <input asp-for="Account.StartingBalance" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Account.StartingBalance" class="text-danger"></span>
                <small class="text-muted">The current value in this virtual account</small>
            </div>
            <div class="mb-3">
                <label asp-for="MatchStringsInput" class="form-label">Match Strings</label>
                <input asp-for="MatchStringsInput" class="form-control" placeholder="e.g., Netbeat, GoDaddy, Namecheap" />
                <small class="text-muted">Comma-separated keywords. Transactions containing any of these will be suggested for this account.</small>
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
