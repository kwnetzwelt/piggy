@page "{id}"
@model Piggy.Pages.Transactions.EditModel
@{
    ViewData["Title"] = "Edit Transaction";
}

<h2>Edit Transaction</h2>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Transaction.Id" />
            <input type="hidden" asp-for="Transaction.ExternalId" />
            <input type="hidden" asp-for="Transaction.ImportedAt" />
            <input type="hidden" asp-for="Transaction.SplitFrom" />
            <input type="hidden" asp-for="Transaction.SplitTemplateId" />
            <input type="hidden" asp-for="Transaction.IsOverflow" />
            <div class="mb-3">
                <label asp-for="Transaction.Date" class="form-label">Date</label>
                <input asp-for="Transaction.Date" class="form-control" type="date" />
            </div>
            <div class="mb-3">
                <label asp-for="Transaction.Description" class="form-label">Description</label>
                <input asp-for="Transaction.Description" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Transaction.Amount" class="form-label">Amount (EUR)</label>
                <input asp-for="Transaction.Amount" class="form-control" type="number" step="0.01" />
            </div>
            <div class="mb-3">
                <label asp-for="Transaction.Currency" class="form-label">Currency</label>
                <input asp-for="Transaction.Currency" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="VirtualAccountId" class="form-label">Virtual Account</label>
                <select asp-for="VirtualAccountId" class="form-select">
                    <option value="">-- None --</option>
                    @foreach (var acc in Model.Accounts)
                    {
                        <option value="@acc.Id">@acc.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" asp-route-Month="@Model.ReturnMonth" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
