@page
@model Piggy.Pages.TwoFactor.VerifyModel
@{
    ViewData["Title"] = "Two-Factor Verification";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-3">Two-Factor Authentication</h4>
                <p class="text-muted text-center mb-4">Enter the code from your authenticator app.</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label for="code" class="form-label">Authenticator Code</label>
                        <input type="text" name="code" id="code" class="form-control form-control-lg text-center"
                               inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="off"
                               placeholder="000000" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-lg">Verify</button>
                </form>
            </div>
        </div>
    </div>
</div>
