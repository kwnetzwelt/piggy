@page
@model Piggy.Pages.Splits.CreateModel
@{
    ViewData["Title"] = "Create Split Template";
}

<h2>Create Split Template</h2>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Template.Name" class="form-label">Template Name</label>
                <input asp-for="Template.Name" class="form-control" placeholder="e.g., Monatliche Kosten" />
                <span asp-validation-for="Template.Name" class="text-danger"></span>
            </div>

            <h4 class="mt-4 mb-3">Split Items</h4>
            <div id="items-container">
                @for (var i = 0; i < Model.Template.Items.Count; i++)
                {
                    <div class="row mb-2 item-row">
                        <div class="col-md-5">
                            <select name="Template.Items[@i].VirtualAccountId" class="form-select form-select-sm">
                                <option value="">-- Select Account --</option>
                                @foreach (var account in Model.Accounts)
                                {
                                    <option value="@account.Id" selected="@(Model.Template.Items[i].VirtualAccountId == account.Id)">
                                        @account.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input name="Template.Items[@i].Amount" class="form-control form-control-sm" type="number" step="0.01"
                                value="@Model.Template.Items[i].Amount" placeholder="Amount" />
                        </div>
                        <div class="col-md-3">
                            <input name="Template.Items[@i].Description" class="form-control form-control-sm"
                                value="@Model.Template.Items[i].Description" placeholder="Description (optional)" />
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItem(this)">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="addItem()">
                <i class="bi bi-plus"></i> Add Item
            </button>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var accountOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Accounts.Select(a => new { value = a.Id, text = a.Name })));

        var itemIndex = @Model.Template.Items.Count;

        function addItem() {
            var container = document.getElementById('items-container');
            var html = '<div class="row mb-2 item-row">' +
                '<div class="col-md-5"><select name="Template.Items[' + itemIndex + '].VirtualAccountId" class="form-select form-select-sm">' +
                '<option value="">-- Select Account --</option>';
            accountOptions.forEach(function(a) {
                html += '<option value="' + a.value + '">' + a.text + '</option>';
            });
            html += '</select></div>' +
                '<div class="col-md-3"><input name="Template.Items[' + itemIndex + '].Amount" class="form-control form-control-sm" type="number" step="0.01" placeholder="Amount" /></div>' +
                '<div class="col-md-3"><input name="Template.Items[' + itemIndex + '].Description" class="form-control form-control-sm" placeholder="Description (optional)" /></div>' +
                '<div class="col-md-1"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItem(this)"><i class="bi bi-x"></i></button></div>' +
                '</div>';
            container.insertAdjacentHTML('beforeend', html);
            itemIndex++;
        }

        function removeItem(btn) {
            btn.closest('.item-row').remove();
        }
    </script>
}
